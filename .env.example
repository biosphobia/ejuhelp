# ─────────────────────────────────────────────────────────────
# BACKEND (server/) — NEVER expose these to the browser
# ─────────────────────────────────────────────────────────────

# ── AI providers ──
# The app supports Gemini (default), Claude, and GPT. The user picks one in
# Settings; if they don't paste their own key there, the server default below
# for the chosen provider is used.

# Default Gemini key (https://aistudio.google.com/app/apikey). This is the
# default provider, so set this to your own key to power the app out of the box.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash

# Optional server default Claude key (https://console.anthropic.com/ -> API Keys).
# Users can instead paste their own Claude key in Settings.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the backend.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# GPT is bring-your-own-key only (users paste their OpenAI key in Settings).
# Optional: override the OpenAI model (default gpt-4o).
# OPENAI_MODEL=gpt-4o

# Port the Express backend listens on (Vite dev proxies /api here).
PORT=8787

# Firebase Admin — used to verify the logged-in user's ID token on API calls.
# Option A: path to a service account JSON file (download from Firebase console
#   -> Project settings -> Service accounts -> Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Option B: paste the whole service account JSON as a single-line string instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ... }

# Local dev only: allow API calls without a logged-in user. NEVER set true in prod.
ALLOW_ANON=true

# ─────────────────────────────────────────────────────────────
# FRONTEND (Vite) — must be prefixed with VITE_ to be exposed.
# These Firebase web config values are safe to ship to the browser.
# (Firebase console -> Project settings -> General -> Your apps -> Web app)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dev: print the exact prompt instead of calling any model (no API key needed).
# EJU_DRY_RUN=1
